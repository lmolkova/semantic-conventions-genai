{#- Docs layout under `docs/<ns>/`, `<ns>` being the first segment of an id:
   - `<op>.md`: hand-written operation docs;
   - `registry/README.md`: generated index of all signals and attributes;
   - `registry/<signal>/[refinement.]<id>.md`: one generated page per signal.
   Urls are root-anchored so they resolve from any page. -#}
{% macro namespace(id) -%}
{{ id | split_id | first }}
{%- endmacro %}
{% macro ns_dir(id) -%}
{{ namespace(id) | trim | kebab_case }}
{%- endmacro %}
{% macro ns_title(ns) -%}
{{ ns | map_text("namespace_titles", ns | title_case | acronym) }}
{%- endmacro %}
{% macro op_path(operation) -%}
{{ ns_dir(operation) | trim }}/{{ (operation | split_id)[1:] | join("_") | kebab_case }}.md
{%- endmacro %}
{#- Prefixed with the namespace when it differs from the operation's, e.g. `OpenAI Client Inference`. -#}
{% macro title(operation, ns=none) -%}
{%- set op_ns = namespace(operation) | trim -%}
{%- if ns and ns != op_ns %}{{ ns_title(ns) | trim }} {% endif -%}
{{ ns_title(op_ns) | trim }} {{ (operation | split_id)[1:] | join("_") | title_case | acronym }}
{%- endmacro %}
{% macro operation_url(operation) -%}
/docs/{{ op_path(operation) | trim }}
{%- endmacro %}
{#- Refinement pages get a `refinement.` prefix. -#}
{% macro signal_path(signal, id, refinement=false) -%}
{{ ns_dir(id) | trim }}/registry/{{ signal }}/{{ "refinement." if refinement }}{{ id }}.md
{%- endmacro %}
{% macro signal_url(signal, id, refinement=false) -%}
/docs/{{ signal_path(signal, id, refinement) | trim }}
{%- endmacro %}
{#- The id of the signal an item refines (its own id for base signals). -#}
{% macro base_id(item) -%}
{{ item.type or item.name }}
{%- endmacro %}
{% macro signal_title(signal) -%}
{{ {"spans": "Span", "metrics": "Metric", "events": "Event", "entities": "Entity"}[signal] }}
{%- endmacro %}
