{#- Adapted from opentelemetry-weaver-packages templates/docs/markdown/namespace_readme.md.j2. -#}
{%- import 'operations.j2' as ops -%}
{%- import 'signal_table.j2' as st -%}
{%- import 'attribute_registry.j2' as ar -%}
{%- set ns = ctx.namespace -%}
{#- One descriptor per section, in page order. Every section but Attributes
   links to the signal's own page. -#}
{%- set sections = [
  {"title": "Entities", "all": ctx.items | selectattr("signal", "equalto", "entities") | list, "signal": "entities"},
  {"title": "Events", "all": ctx.items | selectattr("signal", "equalto", "events") | list, "signal": "events"},
  {"title": "Metrics", "all": ctx.items | selectattr("signal", "equalto", "metrics") | list, "signal": "metrics"},
  {"title": "Spans", "all": ctx.items | selectattr("signal", "equalto", "spans") | list, "signal": "spans"},
  {"title": "Attributes", "all": ctx.attributes}
] -%}
{#- Deprecated signals are pulled out of their own section into a single
   "Deprecated" section at the bottom, which repeats the same sections. -#}
{%- set has_deprecated = sections | map(attribute="all") | flatten | selectattr("deprecated") | list -%}
{#- `intro` is the lead-in paragraph of the Attributes section; the deprecated
   half of that section repeats the heading, not the prose. -#}
{%- macro body(section, signals, intro=false) -%}
{%- if section.signal %}
{{ st.render(signals, section.signal) | trim }}
{% else %}
{% if intro %}Attributes defined in the `{{ ns }}` namespace. Application developers are encouraged to reuse existing attributes; see these [naming recommendations]({{ params.otel_naming_recommendations_url }}) regarding attribute selection and naming for custom use cases.

{% endif %}{{ ar.render(signals) | trim }}
{% endif -%}
{%- endmacro -%}
<!-- NOTE: THIS FILE IS AUTOGENERATED. DO NOT EDIT BY HAND. -->
<!-- see templates/registry/markdown/registry_readme.md.j2 -->

# {{ ops.ns_title(ns) | trim }} registry

{% for section in sections %}{% if section.all | rejectattr("deprecated") | list %}- [{{ section.title }}](#{{ section.title | lower }})
{% endif %}{% endfor -%}
{% if has_deprecated %}- [Deprecated](#deprecated)
{% endif -%}
{#- The deprecated sub-sections repeat the section names, so their anchors get the
   `-1` suffix -- but only when the non-deprecated section is also there. -#}
{% for section in sections %}{% if section.all | selectattr("deprecated") | list %}  - [{{ section.title }}](#{{ section.title | lower }}{{ "-1" if section.all | rejectattr("deprecated") | list }})
{% endif %}{% endfor -%}
{% for section in sections %}{% set current = section.all | rejectattr("deprecated") | list %}{% if current %}
## {{ section.title }}
{{ body(section, current, intro=true) }}{% endif %}{% endfor -%}
{%- if has_deprecated %}
## Deprecated
{% for section in sections %}{% set deprecated = section.all | selectattr("deprecated") | list %}{% if deprecated %}
### {{ section.title }}
{{ body(section, deprecated) }}{% endif %}{% endfor -%}
{% endif -%}
