{% import 'stability.j2' as stability %}
{% import 'notes.j2' as notes %}
{% import 'metric_macros.j2' as metrics %}
{% import 'signal_requirement_level.j2' as sr %}

{# v2 metric objects expose: name, instrument, unit, brief, note, stability, attributes, entity_associations. #}
{% macro header(group) -%}
{{ sr.render(group.requirement_level) }}
{%- endmacro %}

{#- `code_generation.explicit_bucket_boundaries` is the histogram's advisory bucket boundaries. -#}
{% macro boundaries(group) -%}
{%- set b = group.annotations.code_generation.explicit_bucket_boundaries if group.annotations and group.annotations.code_generation else none -%}
{%- if b %}This metric SHOULD be specified with [ExplicitBucketBoundaries](https://github.com/open-telemetry/opentelemetry-specification/blob/v1.55.0/specification/metrics/api.md#instrument-advisory-parameters) of `[{{ b | join(", ") }}]`.

{% endif -%}
{%- endmacro %}

{% macro generate(group) %}| Name | Instrument Type | Unit (UCUM) | Description | Stability | Entity Associations |
| -------- | --------------- | ----------- | -------------- | --------- | ------ |
| `{{ group.name }}` | {{ metrics.instrument(group.instrument) | trim }} | `{{ group.unit }}` | {{ group.brief | trim }}{{ notes.add({"note": group.note}) }} | {{ stability.badge(group.stability, group.deprecated, group.brief) | trim }} | {% if group.entity_associations %}{% for e in group.entity_associations %}{% if not loop.first %}; {% endif %}`{{ e | trim }}`{% endfor %} {% endif %}|
{{ notes.render() }}
{{ boundaries(group) }}{{ header(group) }}
{% endmacro %}
